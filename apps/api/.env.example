# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/educore

# Session signing key; replace in every non-local environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# HTTP
API_PORT=4000
API_ORIGIN=http://localhost:4000

# Runtime
NODE_ENV=development
EDUCORE_STORAGE_BACKEND=local
EDUCORE_S3_BUCKET=
EDUCORE_S3_REGION=us-east-1
EDUCORE_S3_ENDPOINT=
EDUCORE_S3_ACCESS_KEY_ID=
EDUCORE_S3_SECRET_ACCESS_KEY=
EDUCORE_CBT_WORKER_ENABLED=false

# Optional local seed values
SEED_ADMIN_EMAIL=admin@local.school
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters
SEED_SCHOOL_SLUG=local-school
SEED_SCHOOL_NAME=Local School
